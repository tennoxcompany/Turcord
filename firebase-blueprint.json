{
  "entities": {
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Public non-PII user profile for Halka chat platform.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "username": { "type": "string", "minLength": 2, "maxLength": 32, "pattern": "^[a-z0-9_\\.]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 40 },
        "avatarUrl": { "type": "string", "maxLength": 12000 },
        "bannerColor": { "type": "string", "maxLength": 40 },
        "bannerUrl": { "type": "string", "maxLength": 12000 },
        "bio": { "type": "string", "maxLength": 300 },
        "pronouns": { "type": "string", "maxLength": 30 },
        "status": { "type": "string", "enum": ["online", "idle", "dnd", "offline"] },
        "statusEmoji": { "type": "string", "maxLength": 16 },
        "customStatus": { "type": "string", "maxLength": 100 },
        "clanTag": { "type": "string", "maxLength": 8 },
        "avatarDecoration": { "type": "string", "maxLength": 40 },
        "profileEffect": { "type": "string", "maxLength": 40 },
        "nameplate": { "type": "string", "maxLength": 40 },
        "activity": { "type": "object" },
        "badges": { "type": "array" },
        "unlockedCosmetics": { "type": "array" },
        "claimedQuests": { "type": "array" },
        "orbsBalance": { "type": "integer" },
        "connections": { "type": "array" },
        "theme": { "type": "string", "enum": ["oniks", "koyu", "gece"] },
        "showTypingIndicator": { "type": "boolean" },
        "mentionNotifs": { "type": "boolean" },
        "botAlerts": { "type": "boolean" },
        "compactMode": { "type": "boolean" },
        "noiseSuppression": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "displayName", "avatarUrl", "bannerColor", "bio", "status", "customStatus", "createdAt", "updatedAt"]
    },
    "PrivateUserInfo": {
      "title": "PrivateUserInfo",
      "description": "Isolated PII storage for user email and account metadata.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "UserNote": {
      "title": "UserNote",
      "description": "Private note written by a user about another user.",
      "type": "object",
      "properties": {
        "targetUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "note": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["targetUid", "note", "updatedAt"]
    },
    "UserBookmark": {
      "title": "UserBookmark",
      "description": "Saved message bookmark in user's personal bookmarks.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 40 },
        "content": { "type": "string", "maxLength": 2000 },
        "channelLabel": { "type": "string", "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "authorName", "content", "channelLabel", "createdAt"]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "Mention or reply notification delivered to user inbox.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "type": "string", "enum": ["mention", "reply", "system"] },
        "fromUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "fromName": { "type": "string", "minLength": 1, "maxLength": 40 },
        "fromAvatar": { "type": "string", "maxLength": 12000 },
        "channelLabel": { "type": "string", "maxLength": 80 },
        "preview": { "type": "string", "maxLength": 300 },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "type", "fromUid", "fromName", "fromAvatar", "channelLabel", "preview", "isRead", "createdAt"]
    },
    "UsernameClaim": {
      "title": "UsernameClaim",
      "description": "Unique lowercase username lookup record for friend discovery.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "username": { "type": "string", "minLength": 2, "maxLength": 32, "pattern": "^[a-z0-9_\\.]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 40 },
        "avatarUrl": { "type": "string", "maxLength": 12000 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "displayName", "avatarUrl", "updatedAt"]
    },
    "UserMembership": {
      "title": "UserMembership",
      "description": "User's personal index of joined servers.",
      "type": "object",
      "properties": {
        "serverId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "serverName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "serverIcon": { "type": "string", "maxLength": 16 },
        "serverColor": { "type": "string", "maxLength": 20 },
        "role": { "type": "string", "enum": ["owner", "admin", "moderator", "member"] },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["serverId", "userId", "serverName", "serverIcon", "serverColor", "role", "joinedAt"]
    },
    "Server": {
      "title": "Server",
      "description": "A community guild containing text and voice channels.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "description": { "type": "string", "maxLength": 300 },
        "iconEmoji": { "type": "string", "maxLength": 16 },
        "iconColor": { "type": "string", "maxLength": 20 },
        "bannerColor": { "type": "string", "maxLength": 40 },
        "boostCount": { "type": "integer" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "isPublic": { "type": "boolean" },
        "inviteCode": { "type": "string", "minLength": 4, "maxLength": 24, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberCount": { "type": "integer" },
        "enabledBots": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "description", "iconEmoji", "iconColor", "ownerId", "isPublic", "inviteCode", "memberCount", "createdAt", "updatedAt"]
    },
    "Invite": {
      "title": "Invite",
      "description": "Server invite link record mapped by invite code.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 4, "maxLength": 24, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "serverId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "serverName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "serverDescription": { "type": "string", "maxLength": 300 },
        "serverIcon": { "type": "string", "maxLength": 16 },
        "serverColor": { "type": "string", "maxLength": 20 },
        "creatorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "serverId", "serverName", "serverDescription", "serverIcon", "serverColor", "creatorId", "createdAt"]
    },
    "ServerMember": {
      "title": "ServerMember",
      "description": "Authoritative membership and role record for a server.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "serverId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 40 },
        "username": { "type": "string", "minLength": 2, "maxLength": 32 },
        "avatarUrl": { "type": "string", "maxLength": 12000 },
        "role": { "type": "string", "enum": ["owner", "admin", "moderator", "member"] },
        "roleColor": { "type": "string", "maxLength": 20 },
        "avatarDecoration": { "type": "string", "maxLength": 40 },
        "clanTag": { "type": "string", "maxLength": 8 },
        "nameplate": { "type": "string", "maxLength": 40 },
        "activityText": { "type": "string", "maxLength": 80 },
        "inviteCode": { "type": "string", "maxLength": 24 },
        "joinedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "serverId", "displayName", "username", "avatarUrl", "role", "roleColor", "joinedAt", "updatedAt"]
    },
    "Channel": {
      "title": "Channel",
      "description": "Text, voice, or announcement channel within a server.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "serverId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 50 },
        "type": { "type": "string", "enum": ["text", "voice", "announcement"] },
        "category": { "type": "string", "minLength": 1, "maxLength": 40 },
        "topic": { "type": "string", "maxLength": 200 },
        "position": { "type": "integer" },
        "slowmodeSeconds": { "type": "integer" },
        "nsfw": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "serverId", "name", "type", "category", "topic", "position", "createdAt", "updatedAt"]
    },
    "ServerEmoji": {
      "title": "ServerEmoji",
      "description": "Custom emoji uploaded to a server and usable via :name: shortcode.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "serverId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 24, "pattern": "^[a-z0-9_]+$" },
        "imageUrl": { "type": "string", "minLength": 1, "maxLength": 160000 },
        "creatorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "creatorName": { "type": "string", "minLength": 1, "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "serverId", "name", "imageUrl", "creatorId", "creatorName", "createdAt"]
    },
    "ChannelMessage": {
      "title": "ChannelMessage",
      "description": "Real-time message sent inside a server channel.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "serverId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "channelId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 40 },
        "authorAvatar": { "type": "string", "maxLength": 12000 },
        "authorRoleColor": { "type": "string", "maxLength": 20 },
        "content": { "type": "string", "maxLength": 2000 },
        "attachmentUrl": { "type": "string", "maxLength": 300000 },
        "attachmentName": { "type": "string", "maxLength": 120 },
        "replyToId": { "type": "string", "maxLength": 128 },
        "replyToAuthor": { "type": "string", "maxLength": 40 },
        "replyToContent": { "type": "string", "maxLength": 200 },
        "reactions": { "type": "object" },
        "poll": { "type": "object" },
        "pinned": { "type": "boolean" },
        "edited": { "type": "boolean" },
        "isBot": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "serverId", "channelId", "authorId", "authorName", "authorAvatar", "authorRoleColor", "content", "attachmentUrl", "attachmentName", "replyToId", "replyToAuthor", "replyToContent", "reactions", "pinned", "edited", "createdAt", "updatedAt"]
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "Friend request or accepted friendship between two users.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fromUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "fromName": { "type": "string", "minLength": 1, "maxLength": 40 },
        "fromUsername": { "type": "string", "minLength": 2, "maxLength": 32 },
        "fromAvatar": { "type": "string", "maxLength": 12000 },
        "toUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "toName": { "type": "string", "minLength": 1, "maxLength": 40 },
        "toUsername": { "type": "string", "minLength": 2, "maxLength": 32 },
        "toAvatar": { "type": "string", "maxLength": 12000 },
        "participants": { "type": "array" },
        "status": { "type": "string", "enum": ["pending", "accepted"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fromUid", "fromName", "fromUsername", "fromAvatar", "toUid", "toName", "toUsername", "toAvatar", "participants", "status", "createdAt", "updatedAt"]
    },
    "DmThread": {
      "title": "DmThread",
      "description": "Direct message or group DM conversation.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "participants": { "type": "array" },
        "participantProfiles": { "type": "object" },
        "isGroup": { "type": "boolean" },
        "isBotThread": { "type": "boolean" },
        "groupName": { "type": "string", "maxLength": 60 },
        "lastMessage": { "type": "string", "maxLength": 200 },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "participants", "participantProfiles", "lastMessage", "lastMessageAt", "createdAt", "updatedAt"]
    },
    "DmMessage": {
      "title": "DmMessage",
      "description": "Direct message sent inside a DM or Group DM thread.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "threadId": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 40 },
        "authorAvatar": { "type": "string", "maxLength": 12000 },
        "content": { "type": "string", "maxLength": 2000 },
        "attachmentUrl": { "type": "string", "maxLength": 300000 },
        "attachmentName": { "type": "string", "maxLength": 120 },
        "replyToId": { "type": "string", "maxLength": 128 },
        "replyToAuthor": { "type": "string", "maxLength": 40 },
        "replyToContent": { "type": "string", "maxLength": 200 },
        "reactions": { "type": "object" },
        "poll": { "type": "object" },
        "edited": { "type": "boolean" },
        "isBot": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "threadId", "authorId", "authorName", "authorAvatar", "content", "attachmentUrl", "attachmentName", "replyToId", "replyToAuthor", "replyToContent", "reactions", "edited", "createdAt", "updatedAt"]
    },
    "UserPresence": {
      "title": "UserPresence",
      "description": "Live online status heartbeat for users across static and server deployments.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 40 },
        "avatarUrl": { "type": "string", "maxLength": 12000 },
        "status": { "type": "string", "enum": ["online", "idle", "dnd", "offline"] },
        "lastSeenAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "avatarUrl", "status", "lastSeenAt"]
    },
    "VoiceParticipant": {
      "title": "VoiceParticipant",
      "description": "Active participant in a server voice channel or DM call.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "channelId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 40 },
        "username": { "type": "string", "minLength": 2, "maxLength": 32 },
        "avatarUrl": { "type": "string", "maxLength": 12000 },
        "muted": { "type": "boolean" },
        "deafened": { "type": "boolean" },
        "cameraOn": { "type": "boolean" },
        "screenSharing": { "type": "boolean" },
        "speaking": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "channelId", "uid", "displayName", "username", "avatarUrl", "muted", "deafened", "cameraOn", "screenSharing", "speaking", "updatedAt"]
    },
    "VoiceSignal": {
      "title": "VoiceSignal",
      "description": "Ephemeral WebRTC signaling message (offer, answer, ice candidate).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "roomKey": { "type": "string", "minLength": 1, "maxLength": 160 },
        "fromUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "targetUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "type": "string", "enum": ["offer", "answer", "ice"] },
        "payload": { "type": "string", "maxLength": 20000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "roomKey", "fromUid", "targetUid", "type", "payload", "createdAt"]
    },
    "IncomingCall": {
      "title": "IncomingCall",
      "description": "Incoming DM audio/video call ring notification.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fromUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "fromName": { "type": "string", "minLength": 1, "maxLength": 40 },
        "fromAvatar": { "type": "string", "maxLength": 12000 },
        "roomKey": { "type": "string", "minLength": 1, "maxLength": 160 },
        "video": { "type": "boolean" },
        "status": { "type": "string", "enum": ["ringing", "declined"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fromUid", "fromName", "fromAvatar", "roomKey", "video", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/PublicProfile" },
      "description": "Public non-PII user profiles."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/PrivateUserInfo" },
      "description": "Private PII records accessible only to the owning user."
    },
    "/users/{userId}/notes/{targetUid}": {
      "schema": { "$ref": "#/entities/UserNote" },
      "description": "Private personal notes written about other users."
    },
    "/users/{userId}/bookmarks/{bookmarkId}": {
      "schema": { "$ref": "#/entities/UserBookmark" },
      "description": "Saved message bookmarks."
    },
    "/users/{userId}/notifications/{notifId}": {
      "schema": { "$ref": "#/entities/UserNotification" },
      "description": "User notification inbox."
    },
    "/users/{userId}/incomingCalls/{callId}": {
      "schema": { "$ref": "#/entities/IncomingCall" },
      "description": "Incoming DM call rings."
    },
    "/users/{userId}/memberships/{serverId}": {
      "schema": { "$ref": "#/entities/UserMembership" },
      "description": "User's personal index of joined servers."
    },
    "/presence/{userId}": {
      "schema": { "$ref": "#/entities/UserPresence" },
      "description": "Real-time online presence heartbeat documents."
    },
    "/usernames/{username}": {
      "schema": { "$ref": "#/entities/UsernameClaim" },
      "description": "Exact lowercase username lookup table."
    },
    "/servers/{serverId}": {
      "schema": { "$ref": "#/entities/Server" },
      "description": "Community servers."
    },
    "/invites/{inviteCode}": {
      "schema": { "$ref": "#/entities/Invite" },
      "description": "Server invite codes."
    },
    "/servers/{serverId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/ServerMember" },
      "description": "Authoritative server membership and role assignment."
    },
    "/servers/{serverId}/channels/{channelId}": {
      "schema": { "$ref": "#/entities/Channel" },
      "description": "Server channels."
    },
    "/servers/{serverId}/channels/{channelId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChannelMessage" },
      "description": "Messages in a server channel."
    },
    "/servers/{serverId}/emojis/{emojiId}": {
      "schema": { "$ref": "#/entities/ServerEmoji" },
      "description": "Custom server emojis usable across server channels."
    },
    "/servers/{serverId}/voiceParticipants/{participantId}": {
      "schema": { "$ref": "#/entities/VoiceParticipant" },
      "description": "Active participants in server voice channels."
    },
    "/servers/{serverId}/voiceSignals/{signalId}": {
      "schema": { "$ref": "#/entities/VoiceSignal" },
      "description": "WebRTC signaling messages for server voice channels."
    },
    "/friendRequests/{requestId}": {
      "schema": { "$ref": "#/entities/FriendRequest" },
      "description": "Friend requests and active friendships."
    },
    "/dmThreads/{threadId}": {
      "schema": { "$ref": "#/entities/DmThread" },
      "description": "Direct message and Group DM conversations."
    },
    "/dmThreads/{threadId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/DmMessage" },
      "description": "Messages in a DM or Group DM thread."
    },
    "/dmThreads/{threadId}/voiceParticipants/{participantId}": {
      "schema": { "$ref": "#/entities/VoiceParticipant" },
